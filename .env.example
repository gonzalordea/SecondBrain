# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional: enables the AI assistant (RAG chat) and AI summaries. Without it, those return a clear 503 / extractive summaries.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# Set to false only for plain-HTTP local testing; Chrome treats http://localhost as secure anyway.
COOKIE_SECURE=true
# true when running behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=false
APP_PORT=3000
