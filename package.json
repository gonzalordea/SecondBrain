{
  "name": "secondbrain",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "node --env-file-if-exists=.env --watch server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "dev:web": "vite",
    "typecheck": "tsc -p .",
    "test:e2e": "playwright test",
    "make-admin": "node --env-file-if-exists=.env scripts/make-admin.ts",
    "fetch-model": "node scripts/fetch-model.ts",
    "test:pg": "node -e \"process.env.TEST_DB='pg';require('child_process').execSync('npx vitest run',{stdio:'inherit',env:process.env})\""
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "d3-force": "^3.0.1",
    "dompurify": "^3.4.18",
    "fastify": "^5.12.8",
    "marked": "^18.2.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.19",
    "@playwright/test": "^1.65.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true
}
